public class MyClass {
	 
	 static Scanner userinput = new Scanner(System.in);

	 public static void main (String[] args){  
		 System.out.println("How many classes are you entering? ");//get how many classes
		 int classes = userinput.nextInt();
		 
		 double[] grades = new double[classes];//create data structure
		 double[] credits = new double[classes];
		 
		 for (int i = 0; i < classes; i++) {
			 System.out.println("\nClass " + (i + 1) + ":");//get info for each class
			 System.out.print("Enter grade (0.00 - 4.00): ");
			 grades[i] = userinput.nextDouble();
			 while (grades[i] < 0.0 || grades [i] > 4.00) {
				 System.out.println("Invalid grade. Try agian.");
				 grades[i] = userinput.nextDouble();
			 }
			 System.out.print("Enter credits: ");
			 credits[i] = userinput.nextDouble();
			 while (credits[i] <= 0) {
				 System.out.println("Invalid credit. Try again.");
				 credits[i] = userinput.nextDouble();
			 }
		 }
		 
		 double gpa = computeGPA(grades, credits);//call method
		 System.out.printf("\nYour GPA is: %.2f\n", gpa);//print everything out
	 }

	 private static double  computeGPA(double[] grades, double[] credits) {
		double totalGradePoints = 0;
		double totalCredits = 0;
		
		for (int x = 0; x < grades.length; x++) {//calculate gpa
			totalGradePoints += grades[x]*credits[x];
			totalCredits += credits[x];
		}
		return totalGradePoints / totalCredits; //recursive method of calculating
	}
